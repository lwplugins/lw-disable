msgstr ""
"Az LW Disable által kezelt WordPress funkciók engedélyezése vagy letiltása."

#: includes/SiteManager/DisableAbilities.php:80
msgid ""
"Feature flags to update. Keys: comments, admin_new_user_email, emojis, "
"embeds, heartbeat, block_library, xmlrpc, rest_api, application_passwords, "
"generator, shortlink, rsd_link, wlw_manifest, version_strings, "
"adjacent_posts, feeds."
msgstr ""
"Frissítendő funkciókapcsolók. Kulcsok: comments, admin_new_user_email, "
"emojis, embeds, heartbeat, block_library, xmlrpc, rest_api, "
"application_passwords, generator, shortlink, rsd_link, wlw_manifest, "
"version_strings, adjacent_posts, feeds."

#: includes/SiteManager/DisableService.php:66
msgid "Provide an options object with at least one key."
msgstr "Adj meg egy legalább egy kulcsot tartalmazó options objektumot."

#: includes/SiteManager/DisableService.php:86
msgid "No valid option keys provided."
msgstr "Nincs megadva érvényes beállításkulcs."

#. translators: %d: number of options updated
#: includes/SiteManager/DisableService.php:97
#, php-format
msgid "%d option(s) updated."
msgstr "%d beállítás frissítve."

