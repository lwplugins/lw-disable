msgid "LW Disable"
msgstr "LW Disable"

#. Plugin URI of the plugin
#: lw-disable.php
msgid "https://github.com/lwplugins/lw-disable"
msgstr "https://github.com/lwplugins/lw-disable"

#. Description of the plugin
#: lw-disable.php
msgid "Lightweight disable — turn off comments, emojis, embeds, and more."
msgstr ""
"Könnyűsúlyú letiltó bővítmény – kapcsold ki a hozzászólásokat, emojikat, "
"beágyazásokat és még sok mást."

#. Author of the plugin
